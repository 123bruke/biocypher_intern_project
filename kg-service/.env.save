# kg-service/.env - loaded by backend/core/config.py (pydantic-settings).
# Fill in real values and restart the API before use. Keep it secret (gitignored).

# Neo4j - keep in sync with docker/console.env / docker/neo4j.env (bolt = host-side mapped port).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j
