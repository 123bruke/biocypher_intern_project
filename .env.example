# Copy this file to .env and fill in your actual values.
# The .env file is gitignored and must never be committed.

# Required for downloading Disease ontologies via the BioPortal API.
# Register for a free API key at: https://bioportal.bioontology.org/account
BIOPORTAL_API_KEY="818c71a3-2ac2-4509-abed-3d3d63490742"
# backend command code ..........  cd ~/projects/biocypher-kg-console/kg-service && ../.venv/bin/python -m uvicorn backend.api.main:app --host 0.0.0.0 --port 8000
# front end command ............  cd ~/projects/biocypher-kg-console/kg-service/frontend && npm run dev
